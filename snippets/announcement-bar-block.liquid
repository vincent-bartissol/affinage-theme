{% comment %}
	Renders one announcement-bar block (static text or live rewards message).
	Accepts: block
{% endcomment %}
{%- liquid
	assign shipping_threshold = settings.cart_free_shipping_threshold | default: 0 | times: 100
	assign gift_threshold = 0
	assign gift_product = settings.cart_free_gift_product
	if settings.cart_free_gift_enabled and gift_product != blank and settings.cart_free_gift_threshold > 0
		assign gift_threshold = settings.cart_free_gift_threshold | times: 100
	endif

	assign eligible_total = 0
	for item in cart.items
		assign is_gift_line = false
		if gift_product != blank and item.product.id == gift_product.id
			assign is_gift_line = true
		endif
		unless is_gift_line
			assign eligible_total = eligible_total | plus: item.final_line_price
		endunless
	endfor

	assign shipping_unlocked = false
	if shipping_threshold > 0 and eligible_total >= shipping_threshold
		assign shipping_unlocked = true
	endif
	assign gift_unlocked = false
	if gift_threshold > 0 and eligible_total >= gift_threshold
		assign gift_unlocked = true
	endif

	assign shipping_remaining = shipping_threshold | minus: eligible_total
	if shipping_remaining < 0
		assign shipping_remaining = 0
	endif
	assign gift_remaining = gift_threshold | minus: eligible_total
	if gift_remaining < 0
		assign gift_remaining = 0
	endif
	assign shipping_remaining_money = shipping_remaining | money
	assign gift_remaining_money = gift_remaining | money
	assign shipping_from_money = shipping_threshold | money
	assign gift_from_money = gift_threshold | money

	assign rewards_active = false
	if shipping_threshold > 0 or gift_threshold > 0
		assign rewards_active = true
	endif
-%}

{%- case block.type -%}
	{%- when 'free_shipping' -%}
		{%- if rewards_active -%}
			{%- if block.settings.link != blank -%}
				<a
					href="{{ block.settings.link }}"
					class="announcement-bar__link link link--text focus-inset animate-arrow"
				>
			{%- endif -%}
			<p class="announcement-bar__message h5">
				<span data-free-shipping-message>
					{%- if cart == empty -%}
						{%- if shipping_threshold > 0 -%}
							{{ 'sections.announcements.free_shipping_from_html' | t: amount: shipping_from_money }}
						{%- else -%}
							{{ 'sections.announcements.free_gift_from_html' | t: amount: gift_from_money }}
						{%- endif -%}
					{%- elsif shipping_threshold > 0 and shipping_unlocked == false -%}
						{{ 'sections.announcements.free_shipping_remaining_html' | t: amount: shipping_remaining_money }}
					{%- elsif gift_threshold > 0 and gift_unlocked == false -%}
						{{ 'sections.announcements.free_gift_remaining_html' | t: amount: gift_remaining_money }}
					{%- elsif gift_threshold > 0 and shipping_threshold > 0 -%}
						{{ 'sections.announcements.rewards_unlocked' | t }}
					{%- elsif gift_threshold > 0 -%}
						{{ 'sections.announcements.free_gift_unlocked' | t }}
					{%- else -%}
						{{ 'sections.announcements.free_shipping_unlocked' | t }}
					{%- endif -%}
				</span>
				{%- if block.settings.link != blank -%}
					{{- 'icon-arrow.svg' | inline_asset_content -}}
				{%- endif -%}
			</p>
			{%- if block.settings.link != blank -%}
				</a>
			{%- endif -%}
		{%- endif -%}
	{%- when 'announcement' -%}
		{%- if block.settings.text != blank -%}
			{%- if block.settings.link != blank -%}
				<a
					href="{{ block.settings.link }}"
					class="announcement-bar__link link link--text focus-inset animate-arrow"
				>
			{%- endif -%}
			<p class="announcement-bar__message h5">
				<span>{{ block.settings.text | escape }}</span>
				{%- if block.settings.link != blank -%}
					{{- 'icon-arrow.svg' | inline_asset_content -}}
				{%- endif -%}
			</p>
			{%- if block.settings.link != blank -%}
				</a>
			{%- endif -%}
		{%- endif -%}
{%- endcase -%}
