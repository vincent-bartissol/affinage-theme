{% comment %}
	Cart rewards progress: free shipping and/or free gift.
	Eligible total excludes the configured free-gift product line.
{% endcomment %}
{%- liquid
	assign shipping_threshold = settings.cart_free_shipping_threshold | default: 0 | times: 100
	assign gift_threshold = 0
	assign gift_product = settings.cart_free_gift_product
	if settings.cart_free_gift_enabled and gift_product != blank and settings.cart_free_gift_threshold > 0
		assign gift_threshold = settings.cart_free_gift_threshold | times: 100
	endif

	assign eligible_total = 0
	for item in cart.items
		assign is_gift_line = false
		if gift_product != blank and item.product.id == gift_product.id
			assign is_gift_line = true
		endif
		unless is_gift_line
			assign eligible_total = eligible_total | plus: item.final_line_price
		endunless
	endfor

	assign shipping_unlocked = false
	if shipping_threshold > 0 and eligible_total >= shipping_threshold
		assign shipping_unlocked = true
	endif

	assign gift_unlocked = false
	if gift_threshold > 0 and eligible_total >= gift_threshold
		assign gift_unlocked = true
	endif

	assign target_threshold = shipping_threshold
	if gift_threshold > target_threshold
		assign target_threshold = gift_threshold
	endif

	assign shipping_marker = 0
	if target_threshold > 0 and shipping_threshold > 0
		assign shipping_marker = shipping_threshold | times: 100.0 | divided_by: target_threshold
		if shipping_marker > 100
			assign shipping_marker = 100
		endif
	endif

	assign progress = 0
	if target_threshold > 0
		assign progress = eligible_total | times: 100.0 | divided_by: target_threshold
	endif
	if progress > 100
		assign progress = 100
	endif

	assign shipping_remaining = shipping_threshold | minus: eligible_total
	if shipping_remaining < 0
		assign shipping_remaining = 0
	endif
	assign gift_remaining = gift_threshold | minus: eligible_total
	if gift_remaining < 0
		assign gift_remaining = 0
	endif
	assign shipping_remaining_money = shipping_remaining | money
	assign gift_remaining_money = gift_remaining | money

	assign show_rewards = false
	if cart != empty and target_threshold > 0
		assign show_rewards = true
	endif
-%}

{%- if show_rewards -%}
	<div class="cart-shipping-progress cart-rewards-progress" role="status">
		<span class="cart-shipping-progress__label">
			{%- if shipping_threshold > 0 and gift_threshold > 0 -%}
				{%- if shipping_unlocked == false -%}
					{{ 'sections.cart.free_shipping_remaining_html' | t: amount: shipping_remaining_money }}
				{%- elsif gift_unlocked == false -%}
					{{ 'sections.cart.free_shipping_unlocked_gift_remaining_html' | t: amount: gift_remaining_money }}
				{%- else -%}
					{{ 'sections.cart.rewards_unlocked' | t }}
				{%- endif -%}
			{%- elsif shipping_threshold > 0 -%}
				{%- if shipping_unlocked -%}
					{{ 'sections.cart.free_shipping_unlocked' | t }}
				{%- else -%}
					{{ 'sections.cart.free_shipping_remaining_html' | t: amount: shipping_remaining_money }}
				{%- endif -%}
			{%- elsif gift_threshold > 0 -%}
				{%- if gift_unlocked -%}
					{{ 'sections.cart.free_gift_unlocked' | t }}
				{%- else -%}
					{{ 'sections.cart.free_gift_remaining_html' | t: amount: gift_remaining_money }}
				{%- endif -%}
			{%- endif -%}
		</span>

		<span class="cart-shipping-progress__track" aria-hidden="true">
			<span class="cart-shipping-progress__bar" style="width: {{ progress }}%"></span>
			{%- if shipping_threshold > 0 and gift_threshold > 0 and shipping_marker > 0 and shipping_marker < 100 -%}
				<span
					class="cart-rewards-progress__marker{% if shipping_unlocked %} cart-rewards-progress__marker--unlocked{% endif %}"
					style="left: {{ shipping_marker }}%"
					title="{{ 'sections.cart.free_shipping_unlocked' | t | escape }}"
				></span>
			{%- endif -%}
		</span>
	</div>
{%- endif -%}
