{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
	.section-{{ section.id }}-padding {
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  .section-{{ section.id }}-padding {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
	<product-recommendations
		class="related-products-slider page-width section-{{ section.id }}-padding isolate"
		data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
		data-section-id="{{ section.id }}"
		data-product-id="{{ product.id }}"
	>
		{% if recommendations.performed and recommendations.products_count > 0 %}
			{% if section.settings.heading != blank %}
				<h2 class="slider-products__heading {{ section.settings.heading_size }}">
					{{ section.settings.heading }}
				</h2>
			{% endif %}

			<slider-products
				class="slider-products swiper"
				data-params='{ "loop": false, "autoplay": false }'
				data-pagination="false"
				data-navigation="true"
				data-scrollbar="false"
			>
				<div class="slider-products__container swiper-wrapper">
					{% for recommendation in recommendations.products %}
						<div class="slider-products__item swiper-slide">
							{% render 'card-product',
								card_product: recommendation,
								media_aspect_ratio: section.settings.image_ratio,
								show_secondary_image: section.settings.show_secondary_image,
								show_vendor: section.settings.show_vendor,
								show_rating: section.settings.show_rating
							%}
						</div>
					{% endfor %}
				</div>
				<div class="swiper-button-prev"></div>
				<div class="swiper-button-next"></div>
			</slider-products>
		{% endif %}
	</product-recommendations>
</div>

{% schema %}
	{
		"name": "Related products slider",
		"tag": "section",
		"class": "section",
		"settings": [
			{
				"type": "inline_richtext",
				"id": "heading",
				"default": "You may also like",
				"label": "Heading"
			},
			{
				"type": "select",
				"id": "heading_size",
				"options": [
					{ "value": "h2", "label": "Small" },
					{ "value": "h1", "label": "Medium" },
					{ "value": "h0", "label": "Large" }
				],
				"default": "h2",
				"label": "Heading size"
			},
			{
				"type": "range",
				"id": "products_to_show",
				"min": 2,
				"max": 10,
				"step": 1,
				"default": 6,
				"label": "Maximum products to show"
			},
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "Color scheme",
				"default": "scheme-1"
			},
			{
				"type": "select",
				"id": "image_ratio",
				"options": [
					{ "value": "adapt", "label": "Adapt" },
					{ "value": "portrait", "label": "Portrait" },
					{ "value": "square", "label": "Square" }
				],
				"default": "portrait",
				"label": "Image ratio"
			},
			{
				"type": "checkbox",
				"id": "show_secondary_image",
				"default": true,
				"label": "Show second image on hover"
			},
			{
				"type": "checkbox",
				"id": "show_vendor",
				"default": false,
				"label": "Show vendor"
			},
			{
				"type": "checkbox",
				"id": "show_rating",
				"default": false,
				"label": "Show product rating"
			},
			{
				"type": "range",
				"id": "padding_top",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "Padding top",
				"default": 36
			},
			{
				"type": "range",
				"id": "padding_bottom",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "Padding bottom",
				"default": 36
			}
		],
		"presets": [
			{
				"name": "Related products slider"
			}
		]
	}
{% endschema %}
