{%- comment -%} Fixed overlay text over fading background images {%- endcomment -%}
{%- liquid
	assign hero_height = section.settings.image_height
	assign overlay_opacity = section.settings.image_overlay_opacity | divided_by: 100.0
-%}

<div
	id="HeroBackground-{{ section.id }}"
	class="hero-background-slider color-{{ section.settings.color_scheme }} gradient"
	data-section-id="{{ section.id }}"
>
	<div class="hero-background-slider__inner hero-background-slider--{{ hero_height }}">
		{%- if section.blocks.size > 0 -%}
			<hero-background-slider
				class="hero-background-slider__swiper swiper"
				data-params='
					{
						"slidesPerView": 1,
						"spaceBetween": 0,
						"loop": true,
						"effect": "fade",
						"fadeEffect": { "crossFade": true },
						"autoplay": { "delay": {{ section.settings.autoplay_delay | default: 5000 }}, "disableOnInteraction": false },
						"speed": 900
					}
				'
				data-pagination="{{ section.settings.show_pagination }}"
				data-navigation="false"
				data-scrollbar="false"
			>
				<div class="swiper-wrapper">
					{%- for block in section.blocks -%}
						<div class="hero-background-slider__slide swiper-slide" {{ block.shopify_attributes }}>
							{%- if block.settings.image != blank -%}
								{%- liquid
									assign img_loading = 'lazy'
									assign img_fetchpriority = 'auto'
									if forloop.first
										assign img_loading = 'eager'
										assign img_fetchpriority = 'high'
									endif
									assign img_alt = block.settings.image.alt | default: section.settings.heading
								-%}
								{{
									block.settings.image
									| image_url: width: 3840
									| image_tag:
										loading: img_loading,
										fetchpriority: img_fetchpriority,
										class: 'hero-background-slider__image',
										sizes: '100vw',
										widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
										alt: img_alt
								}}
							{%- else -%}
								{{ 'lifestyle-1' | placeholder_svg_tag: 'hero-background-slider__placeholder' }}
							{%- endif -%}
						</div>
					{%- endfor -%}
				</div>
				{%- if section.settings.show_pagination and section.blocks.size > 1 -%}
					<div class="swiper-pagination hero-background-slider__pagination"></div>
				{%- endif -%}
			</hero-background-slider>
		{%- else -%}
			<div class="hero-background-slider__fallback">
				{{ 'lifestyle-1' | placeholder_svg_tag: 'hero-background-slider__placeholder' }}
			</div>
		{%- endif -%}

		<div
			class="hero-background-slider__overlay"
			style="--hero-overlay-opacity: {{ overlay_opacity }};"
			aria-hidden="true"
		></div>

		<div class="hero-background-slider__content page-width">
			<div class="hero-background-slider__text hero-background-slider__text--{{ section.settings.content_alignment }}">
				{%- if section.settings.heading != blank -%}
					<h1 class="hero-background-slider__heading {{ section.settings.heading_size }}">
						{{ section.settings.heading }}
					</h1>
				{%- endif -%}
				{%- if section.settings.text != blank -%}
					<p class="hero-background-slider__subheading">{{ section.settings.text }}</p>
				{%- endif -%}
				{%- if section.settings.button_label != blank -%}
					<a
						{% if section.settings.button_link != blank %}
							href="{{ section.settings.button_link }}"
						{% else %}
							role="link"
							aria-disabled="true"
						{% endif %}
						class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
					>
						{{- section.settings.button_label | escape -}}
					</a>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
	{
		"name": "Hero background slider",
		"tag": "section",
		"class": "section section-hero-background-slider",
		"max_blocks": 6,
		"settings": [
			{
				"type": "text",
				"id": "heading",
				"label": "Heading",
				"default": "Maison Affinage"
			},
			{
				"type": "select",
				"id": "heading_size",
				"options": [
					{ "value": "h2", "label": "Small" },
					{ "value": "h1", "label": "Medium" },
					{ "value": "h0", "label": "Large" }
				],
				"default": "h0",
				"label": "Heading size"
			},
			{
				"type": "textarea",
				"id": "text",
				"label": "Text",
				"default": "Cheeses aged in our cave, cut to order, and shipped cold."
			},
			{
				"type": "text",
				"id": "button_label",
				"label": "Button label",
				"default": "Shop the cave"
			},
			{
				"type": "url",
				"id": "button_link",
				"label": "Button link"
			},
			{
				"type": "checkbox",
				"id": "button_style_secondary",
				"label": "Use outline button style",
				"default": false
			},
			{
				"type": "select",
				"id": "content_alignment",
				"options": [
					{ "value": "left", "label": "Left" },
					{ "value": "center", "label": "Center" },
					{ "value": "right", "label": "Right" }
				],
				"default": "center",
				"label": "Content alignment"
			},
			{
				"type": "select",
				"id": "image_height",
				"options": [
					{ "value": "small", "label": "Small" },
					{ "value": "medium", "label": "Medium" },
					{ "value": "large", "label": "Large" }
				],
				"default": "large",
				"label": "Hero height"
			},
			{
				"type": "range",
				"id": "image_overlay_opacity",
				"min": 0,
				"max": 100,
				"step": 10,
				"unit": "%",
				"label": "Image overlay opacity",
				"default": 50
			},
			{
				"type": "range",
				"id": "autoplay_delay",
				"min": 3000,
				"max": 9000,
				"step": 1000,
				"unit": "ms",
				"label": "Autoplay delay",
				"default": 5000
			},
			{
				"type": "checkbox",
				"id": "show_pagination",
				"label": "Show dots",
				"default": true
			},
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "Color scheme",
				"default": "scheme-3"
			}
		],
		"blocks": [
			{
				"type": "image",
				"name": "Background image",
				"settings": [
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					}
				]
			}
		],
		"presets": [
			{
				"name": "Hero background slider",
				"blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }]
			}
		]
	}
{% endschema %}
