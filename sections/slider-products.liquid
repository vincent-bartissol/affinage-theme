{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_quick_add -%}
	{{ 'quick-add.css' | asset_url | stylesheet_tag }}
	<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="slider-products-section page-width color-{{ section.settings.color_scheme }}">
	{% if section.settings.title != blank %}
		<h2 class="slider-products__heading {{ section.settings.heading_size }}">
			{{ section.settings.title }}
		</h2>
	{% endif %}

	{% if section.settings.description != blank %}
		<p class="slider-products__description">{{ section.settings.description }}</p>
	{% endif %}

	<slider-products
		class="slider-products swiper"
		data-params='
			{
			  "spaceBetween": {{ section.settings.space_between | default: 16 }},
			  "loop": {{ section.settings.loop | default: true }},
			  "autoplay": {{ section.settings.autoplay | default: false }}
			}
		'
		data-pagination="{{ section.settings.pagination | default: false }}"
		data-navigation="{{ section.settings.navigation | default: false }}"
		data-scrollbar="{{ section.settings.scrollbar | default: false }}"
	>
		<div class="slider-products__container swiper-wrapper">
			{% assign collection = collections[section.settings.collection] %}
			{% assign max_products = section.settings.max_collection | default: 8 %}
			{% assign quick_add = 'none' %}
			{% if section.settings.show_quick_add %}
				{% assign quick_add = 'standard' %}
			{% endif %}

			{% if collection != blank %}
				{% for product in collection.products limit: max_products %}
					<div class="slider-products__item swiper-slide">
						{% render 'card-product',
							card_product: product,
							media_aspect_ratio: 'portrait',
							show_secondary_image: true,
							quick_add: quick_add,
							section_id: section.id
						%}
					</div>
				{% endfor %}
			{% endif %}

			{% for block in section.blocks %}
				{% if block.settings.product != blank %}
					<div class="slider-products__item swiper-slide" {{ block.shopify_attributes }}>
						{% render 'card-product',
							card_product: block.settings.product,
							media_aspect_ratio: 'portrait',
							show_secondary_image: true,
							quick_add: quick_add,
							section_id: section.id
						%}
					</div>
				{% endif %}
			{% endfor %}
		</div>

		{% if section.settings.pagination %}
			<div class="swiper-pagination"></div>
		{% endif %}

		{% if section.settings.navigation %}
			<div class="swiper-button-prev"></div>
			<div class="swiper-button-next"></div>
		{% endif %}

		{% if section.settings.scrollbar %}
			<div class="swiper-scrollbar"></div>
		{% endif %}
	</slider-products>
</div>

{% schema %}
	{
		"name": "Slider Products",
		"tag": "section",
		"class": "section slider-products-section",
		"settings": [
			{
				"type": "text",
				"id": "title",
				"label": "Title",
				"default": "From the cave"
			},
			{
				"type": "select",
				"id": "heading_size",
				"options": [
					{ "value": "h2", "label": "Small" },
					{ "value": "h1", "label": "Medium" },
					{ "value": "h0", "label": "Large" }
				],
				"default": "h2",
				"label": "Heading size"
			},
			{
				"type": "text",
				"id": "description",
				"label": "Description"
			},
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "Color scheme",
				"default": "scheme-1"
			},
			{
				"type": "header",
				"content": "Collection"
			},
			{
				"type": "collection",
				"id": "collection",
				"label": "Collection"
			},
			{
				"type": "number",
				"id": "max_collection",
				"label": "Maximum products from collection",
				"default": 8
			},
			{
				"type": "checkbox",
				"id": "show_quick_add",
				"label": "Quick add",
				"default": false
			},
			{
				"type": "header",
				"content": "Slider"
			},
			{
				"type": "checkbox",
				"id": "pagination",
				"label": "Pagination",
				"default": false
			},
			{
				"type": "checkbox",
				"id": "navigation",
				"label": "Navigation",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "scrollbar",
				"label": "Scrollbar",
				"default": false
			},
			{
				"type": "checkbox",
				"id": "loop",
				"label": "Loop",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "autoplay",
				"label": "Autoplay",
				"default": false
			}
		],
		"max_blocks": 8,
		"blocks": [
			{
				"type": "product",
				"name": "Product",
				"settings": [
					{
						"type": "product",
						"id": "product",
						"label": "Product"
					}
				]
			}
		],
		"presets": [
			{
				"name": "Slider Products"
			}
		]
	}
{% endschema %}
