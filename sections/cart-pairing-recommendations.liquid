{% comment %}
	Fetched by product-recommendations for cart drawer pairings.
	Uses complementary products when configured (Search & Discovery),
	otherwise related product recommendations (via JS fallback intent).
{% endcomment %}
{%- liquid
	assign shown = 0
-%}
<product-recommendations class="cart-pairing-recommendations">
	{%- if recommendations.performed and recommendations.products_count > 0 -%}
		{%- capture pairing_items -%}
			{%- for product in recommendations.products limit: 6 -%}
				{%- liquid
					if shown >= 4
						break
					endif
					assign already_in_cart = false
					for item in cart.items
						if item.product_id == product.id
							assign already_in_cart = true
							break
						endif
					endfor
					if already_in_cart
						continue
					endif
					assign variant = product.selected_or_first_available_variant
					assign shown = shown | plus: 1
				-%}
				<li class="cart-pairing__item">
					<a
						href="{{ product.url }}"
						class="cart-pairing__media"
						aria-hidden="true"
						tabindex="-1"
					>
						{%- if product.featured_media -%}
							{{
								product.featured_media
								| image_url: width: 360
								| image_tag:
									loading: 'lazy',
									class: 'cart-pairing__image',
									widths: '160, 240, 360',
									sizes: '(min-width: 990px) 200px, 72px',
									alt: ''
							}}
						{%- endif -%}
					</a>
					<div class="cart-pairing__meta">
						<a href="{{ product.url }}" class="cart-pairing__name">{{ product.title | escape }}</a>
						<span class="cart-pairing__price">
							{%- if variant.compare_at_price > variant.price -%}
								<s>{{ variant.compare_at_price | money }}</s>
								{{ variant.price | money }}
							{%- else -%}
								{{ variant.price | money }}
							{%- endif -%}
						</span>
						{%- if variant.available -%}
							{%- assign pairing_form_id = 'cart-pairing-' | append: product.id -%}
							<product-form data-section-id="cart-pairing-recommendations" data-hide-errors="true">
								{%- form 'product',
									product,
									id: pairing_form_id,
									class: 'cart-pairing__form',
									novalidate: 'novalidate',
									data-type: 'add-to-cart-form'
								-%}
									<input
										type="hidden"
										name="id"
										value="{{ variant.id }}"
										class="product-variant-id"
									>
									<button
										id="{{ pairing_form_id }}-submit"
										type="submit"
										name="add"
										class="cart-pairing__cta button button--secondary"
										aria-live="polite"
										data-sold-out-message="true"
									>
										<span>{{ 'products.product.add_to_cart' | t }}</span>
										<span class="sold-out-message hidden">
											{{ 'products.product.sold_out' | t }}
										</span>
										{%- render 'loading-spinner' -%}
									</button>
								{%- endform -%}
							</product-form>
						{%- endif -%}
					</div>
				</li>
			{%- endfor -%}
		{%- endcapture -%}

		{%- if shown > 0 -%}
			<div class="cart-pairing">
				<p class="cart-pairing__title">{{ 'sections.cart.pairing_title' | t }}</p>
				<ul class="cart-pairing__list" role="list">
					{{- pairing_items -}}
				</ul>
			</div>
		{%- endif -%}
	{%- endif -%}
</product-recommendations>

{% schema %}
	{
		"name": "Cart pairing recs",
		"settings": []
	}
{% endschema %}
