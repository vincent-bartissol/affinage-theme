{
	"sections": {
		"main": {
			"type": "main-product",
			"blocks": {
				"vendor": {
					"type": "text",
					"settings": {
						"text": "{{ product.vendor }}",
						"text_style": "uppercase"
					}
				},
				"title": {
					"type": "title"
				},
				"caption": {
					"type": "text",
					"settings": {
						"text": "{{ product.metafields.descriptors.subtitle.value }}",
						"text_style": "subtitle"
					}
				},
				"price": {
					"type": "price"
				},
				"variant_picker": {
					"type": "variant_picker",
					"settings": {
						"picker_type": "button"
					}
				},
				"quantity_selector": {
					"type": "quantity_selector"
				},
				"buy_buttons": {
					"type": "buy_buttons",
					"settings": {
						"show_dynamic_checkout": true,
						"show_gift_card_recipient": false
					}
				},
				"description": {
					"type": "description"
				},
				"collapsible-row-0": {
					"type": "collapsible_tab",
					"settings": {
						"heading": "Milk & origin",
						"icon": "dairy",
						"content": "<p>Ask our counter for the producer, milk type, and aging for this cut.</p>",
						"page": ""
					}
				},
				"collapsible-row-1": {
					"type": "collapsible_tab",
					"settings": {
						"heading": "Shipping & storage",
						"icon": "truck",
						"content": "<p>Ships cold-packed. Keep refrigerated and bring to room temperature 30 minutes before serving.</p>",
						"page": ""
					}
				},
				"collapsible-row-2": {
					"type": "collapsible_tab",
					"settings": {
						"heading": "Pairing",
						"icon": "heart",
						"content": "<p>See the tasting note on each product for wine, bread, and fruit ideas.</p>",
						"page": ""
					}
				},
				"share": {
					"type": "share",
					"settings": {
						"share_label": "Share"
					}
				}
			},
			"block_order": [
				"vendor",
				"title",
				"caption",
				"price",
				"variant_picker",
				"quantity_selector",
				"buy_buttons",
				"description",
				"collapsible-row-0",
				"collapsible-row-1",
				"collapsible-row-2",
				"share"
			],
			"settings": {
				"enable_sticky_info": true,
				"gallery_layout": "thumbnail",
				"media_size": "large",
				"constrain_to_viewport": true,
				"mobile_thumbnails": "show",
				"hide_variants": true,
				"enable_video_looping": false,
				"padding_top": 36,
				"padding_bottom": 12
			}
		},
		"promises": {
			"type": "multicolumn",
			"blocks": {
				"column-0": {
					"type": "column",
					"settings": {
						"title": "Cold pack",
						"text": "<p>Insulated packaging and ice packs keep soft rinds and blues at the right temperature in transit.</p>",
						"link_label": "",
						"link": ""
					}
				},
				"column-1": {
					"type": "column",
					"settings": {
						"title": "Storage",
						"text": "<p>Wrap in cheese paper or waxed paper, refrigerate, and finish within a few days of opening.</p>",
						"link_label": "",
						"link": ""
					}
				},
				"column-2": {
					"type": "column",
					"settings": {
						"title": "Pairing",
						"text": "<p>Each cut includes a short note — milk, texture, and what to pour or serve beside it.</p>",
						"link_label": "",
						"link": ""
					}
				}
			},
			"block_order": ["column-0", "column-1", "column-2"],
			"settings": {
				"title": "How we ship cheese",
				"heading_size": "h2",
				"image_width": "full",
				"image_ratio": "adapt",
				"columns_desktop": 3,
				"column_alignment": "left",
				"background_style": "none",
				"button_label": "",
				"button_link": "",
				"swipe_on_mobile": false,
				"color_scheme": "scheme-2",
				"columns_mobile": "1",
				"padding_top": 48,
				"padding_bottom": 36
			}
		},
		"related-products": {
			"type": "related-products-slider",
			"settings": {
				"heading": "You may also like",
				"heading_size": "h2",
				"products_to_show": 6,
				"color_scheme": "scheme-1",
				"image_ratio": "portrait",
				"show_secondary_image": true,
				"show_vendor": false,
				"show_rating": false,
				"padding_top": 36,
				"padding_bottom": 48
			}
		}
	},
	"order": ["main", "promises", "related-products"]
}
